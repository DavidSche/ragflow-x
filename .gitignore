# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Runtime config carries real credentials (DB password, RAGFlow API key).
# Secrets must be injected via RGX_* environment variables, never committed.
config/config.yaml

# Local secrets and environment files
.env
.env.*
.env.local
*.secret

# Runtime data and databases
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Encrypted runtime secrets and keys created by the first-run wizard
config/runtime.secrets.json
config/.master.key
config/rsa_setup.pem

# Logs
logs/
*.log

# Build artifacts
web/dist/
web/dist2/
web/dist3/
web/web.rar
web/node_modules/
web/coverage/
web/coverage-report/
web/test-results/
web/playwright-report/
.gocache/
bin/
test-results/
ragflow-x-server
.go-test-service.json
run/

# IDE / OS
.idea/
.vscode/
