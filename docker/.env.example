# Copy to docker/.env and fill in production values.
# Minimal required for a one-click admin: set RGX_ADMIN_PASSWORD (otherwise the
# HTTP setup wizard must be used on first boot).

# Admin bootstrap (empty password disables auto-bootstrap -> use setup wizard)
RGX_ADMIN_USER=admin
RGX_ADMIN_PASSWORD=

# Secrets: MUST be set before compose up; the stack refuses insecure defaults.
# Master key encrypts runtime secrets; losing it loses decrypted credentials.
RGX_MASTER_KEY=
RGX_JWT_SECRET=

# Database
RGX_DB_PASSWORD=

# RAGFlow engine (external)
RGX_RAGFLOW_BASE_URL=http://ragflow:9380
RGX_RAGFLOW_API_KEY=
